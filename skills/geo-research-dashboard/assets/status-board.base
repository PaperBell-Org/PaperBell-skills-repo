# generated by sync_status.py (geo-research-dashboard); rewritten on every sync
filters:
  and:
    - file.hasTag("status-card")
    - file.hasTag("project/<acronym>")
properties:
  note.status_stage:
    displayName: Stage
  note.decisions_open:
    displayName: Open decisions
views:
  - type: table
    name: All projects
    order:
      - file.name
      - status_stage
      - status_updated
      - decisions_open
      - status_mtime
      - status_path
      - synced
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 220
      note.status_stage: 360
      note.status_updated: 130
      note.decisions_open: 80
      note.status_mtime: 130
      note.status_path: 300
      note.synced: 130
  - type: table
    name: Has open decisions
    filters:
      and:
        - decisions_open > 0
    order:
      - file.name
      - decisions_open
      - status_stage
      - status_updated
    sort:
      - property: decisions_open
        direction: DESC
